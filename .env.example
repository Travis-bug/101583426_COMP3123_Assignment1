# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development

# Local MongoDB (default). For Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/comp3123_assignment1
MONGODB_URI=mongodb://127.0.0.1:27018/comp3123_assignment1

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Rate limits per IP per 15 minutes: signup/login, and all other /api/v1 routes.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=100
